{
  "cleanUrls": true,
  "functions": {
    "api/**/*.py": {
      "runtime": "@vercel/python"
    }
  },
  "rewrites": [
    {
      "source": "/api/apps/public/prod/public-settings/by-id/:id",
      "destination": "/api/apps/public/prod/public-settings/by-id/:id.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/:path+",
      "destination": "/index.html"
    }
  ]
}
