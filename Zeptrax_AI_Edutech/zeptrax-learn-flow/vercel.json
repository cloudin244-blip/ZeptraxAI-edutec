{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/portal/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/portal/(index.html)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/apps/public/prod/public-settings/by-id/:id",
      "destination": "/static-api/apps/public/prod/public-settings/by-id/:id"
    },
    {
      "source": "/api/status",
      "destination": "/api/index"
    },
    {
      "source": "/api/apps/auth/login",
      "destination": "/api/index"
    },
    {
      "source": "/api/apps/auth/:provider/login",
      "destination": "/api/index"
    },
    {
      "source": "/api/apps/:appId/entities/:entity/me",
      "destination": "/api/index"
    },
    {
      "source": "/api/apps/:appId/analytics/track/batch",
      "destination": "/api/index"
    },
    {
      "source": "/api/apps/:appId/integration-endpoints/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/((?!index$).*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|static-api/).*)",
      "destination": "/"
    }
  ]
}
