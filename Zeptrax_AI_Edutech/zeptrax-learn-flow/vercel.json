{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/apps/public/prod/public-settings/by-id/:id",
      "destination": "/static-api/apps/public/prod/public-settings/by-id/:id.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/:path+",
      "destination": "/index.html"
    }
  ]
}
